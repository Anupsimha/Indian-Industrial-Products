# ==============================================================================
# Indian Industrial Products (IIP) - Backend Environment Configuration Example
# ==============================================================================

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=postgresql://user:password@localhost:5432/iip_db

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=IIP Platform <your_email@gmail.com>

# Configurable Media Upload Limits (in MB)
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=100

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Shiprocket Logistics Integration
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_PINCODE=560073

# iThink Logistics Integration
ITHINK_ACCESS_TOKEN="your_ithink_access_token"
ITHINK_SECRET_KEY="your_ithink_secret_key"
ITHINK_BASE_URL="https://my.ithinklogistics.com/api_v3"
ITHINK_DEFAULT_PICKUP_PINCODE="560073"

# Hostinger Developer API (Custom Subdomain & DNS Management)
HOSTINGER_API_TOKEN="your_hostinger_api_token"
HOSTINGER_BASE_URL="https://developers.hostinger.com"
HOSTINGER_ZONE_DOMAIN="indianindustrialplatform.com"
SERVER_PUBLIC_IP="200.141.14.101"

# Support Contact
REACT_APP_SUPPORT_PHONE="9380036328"
REACT_APP_SUPPORT_WHATSAPP="9380036328"
REACT_APP_SUPPORT_EMAIL="support@indianindustrialplatform.com"
